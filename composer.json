{
  "name": "trustcrypto/platform",
  "description": "Trustcrypto — Crypto investment platform with debit card issuance. PHP 8.2 + MySQL.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-mbstring": "*",
    "ext-json": "*",
    "ext-fileinfo": "*",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/Core/helpers.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "post-install-cmd": [
      "@php -r \"is_dir('storage/logs') || mkdir('storage/logs', 0775, true);\"",
      "@php -r \"is_dir('storage/cache') || mkdir('storage/cache', 0775, true);\"",
      "@php -r \"is_dir('storage/sessions') || mkdir('storage/sessions', 0775, true);\""
    ]
  }
}
